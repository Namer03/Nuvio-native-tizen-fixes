From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: nv <noreply@anthropic.com>
Date: Fri, 23 Oct 2026 22:00:00 +0200
Subject: [PATCH 4/4] libass: parallel renderers (per-thread stage timers via
 pthread keys, track clone, blur split minimum and split counters)

diff -ruN a/libass/arm/neon32.c b/libass/arm/neon32.c
--- a/libass/arm/neon32.c
+++ b/libass/arm/neon32.c
@@ -302,6 +302,33 @@
 
 static size_t nv32_par_min = 65536;
 
+/* Nuvio 0004: what nv32_par did with each job (process wide, atomics; read
+ * and reset by ass_nv_par_stats_take). */
+static unsigned nv32_st_jobs, nv32_st_split, nv32_st_small, nv32_st_busy, nv32_st_one;
+static unsigned long long nv32_st_lanes, nv32_st_lanes_split;
+
+void ass_nv32_set_par_min(size_t lanes)
+{
+    __atomic_store_n(&nv32_par_min, lanes, __ATOMIC_RELAXED);
+}
+
+size_t ass_nv32_get_par_min(void)
+{
+    return __atomic_load_n(&nv32_par_min, __ATOMIC_RELAXED);
+}
+
+void ass_nv32_par_stats_take(unsigned *jobs, unsigned *split, unsigned *small, unsigned *busy,
+                             unsigned *one, unsigned long long *lanes, unsigned long long *lanes_split)
+{
+    *jobs = __atomic_exchange_n(&nv32_st_jobs, 0, __ATOMIC_RELAXED);
+    *split = __atomic_exchange_n(&nv32_st_split, 0, __ATOMIC_RELAXED);
+    *small = __atomic_exchange_n(&nv32_st_small, 0, __ATOMIC_RELAXED);
+    *busy = __atomic_exchange_n(&nv32_st_busy, 0, __ATOMIC_RELAXED);
+    *one = __atomic_exchange_n(&nv32_st_one, 0, __ATOMIC_RELAXED);
+    *lanes = __atomic_exchange_n(&nv32_st_lanes, 0, __ATOMIC_RELAXED);
+    *lanes_split = __atomic_exchange_n(&nv32_st_lanes_split, 0, __ATOMIC_RELAXED);
+}
+
 /* Runs fn over [0, n) split in parts. `work` is the number of int16 lanes
  * touched; small jobs stay on the calling thread (waking helpers costs more). */
 static void nv32_par(Nv32Part *fn, const void *job, size_t n, size_t work)
@@ -310,10 +337,25 @@
     size_t parts = (size_t) threads;
     if (parts > n)
         parts = n;
-    if (parts <= 1 || work < nv32_par_min || pthread_mutex_trylock(&nv32_pool.call)) {
+    __atomic_add_fetch(&nv32_st_jobs, 1, __ATOMIC_RELAXED);
+    __atomic_add_fetch(&nv32_st_lanes, (unsigned long long) work, __ATOMIC_RELAXED);
+    if (parts <= 1) {
+        __atomic_add_fetch(&nv32_st_one, 1, __ATOMIC_RELAXED);
+        fn(job, 0, n);
+        return;
+    }
+    if (work < __atomic_load_n(&nv32_par_min, __ATOMIC_RELAXED)) {
+        __atomic_add_fetch(&nv32_st_small, 1, __ATOMIC_RELAXED);
+        fn(job, 0, n);
+        return;
+    }
+    if (pthread_mutex_trylock(&nv32_pool.call)) {
+        __atomic_add_fetch(&nv32_st_busy, 1, __ATOMIC_RELAXED);
         fn(job, 0, n);
         return;
     }
+    __atomic_add_fetch(&nv32_st_split, 1, __ATOMIC_RELAXED);
+    __atomic_add_fetch(&nv32_st_lanes_split, (unsigned long long) work, __ATOMIC_RELAXED);
     pthread_mutex_lock(&nv32_pool.lock);
     nv32_pool.fn = fn;
     nv32_pool.job = job;
diff -ruN a/libass/ass.h b/libass/ass.h
--- a/libass/ass.h
+++ b/libass/ass.h
@@ -893,6 +893,42 @@
  */
 void ass_nv_flush_caches(ASS_Renderer *priv);
 
+#define ASS_NV_API_PARALELO 1
+
+/*
+ * 0004 (parallel renderers). The stage timers above are kept per thread:
+ * ass_nv_perf_take returns what the CALLING thread rendered.
+ */
+
+/**
+ * \brief Smallest job (int16 lanes) the NEON blur splits across threads
+ * (process wide, default 65536).
+ */
+void ass_nv_set_par_min(size_t lanes);
+size_t ass_nv_get_par_min(void);
+
+typedef struct ass_nv_par_stats {
+    unsigned jobs;      // stripe-pipeline jobs run
+    unsigned split;     // split across the threads
+    unsigned small;     // run on one thread: smaller than the split minimum
+    unsigned busy;      // run on one thread: another renderer was using the pool
+    unsigned single;    // run on one thread: 1 thread wanted (or 1 stripe)
+    unsigned long long lanes, lanes_split;  // int16 lanes in all jobs / in split jobs
+} ASS_NvParStats;
+
+/**
+ * \brief Copy the blur split counters (all threads) and reset them.
+ */
+void ass_nv_par_stats_take(ASS_NvParStats *out);
+
+/**
+ * \brief Deep copy of a track (styles, events, header and feature flags) for
+ * another renderer: libass keeps per-renderer layout state inside the events,
+ * so two renderers must never render the same ASS_Track at the same time.
+ * The copy shares the library. Returns NULL without memory.
+ */
+ASS_Track *ass_nv_track_clone(ASS_Track *src);
+
 #undef ASS_DEPRECATED
 #undef ASS_DEPRECATED_ENUM
 
diff -ruN a/libass/ass_cache.c b/libass/ass_cache.c
--- a/libass/ass_cache.c
+++ b/libass/ass_cache.c
@@ -384,7 +384,7 @@
 // to extend its lifetime further, call ass_cache_inc_ref().
 static inline void nv_cache_count(const CacheDesc *desc, int hit)
 {
-    if (!ass_nv_active)
+    if (!ass_nv_timing())
         return;
     if (desc == &outline_cache_desc)
         ass_nv_cache_count_slow(ASS_NV_CACHE_OUTLINE, hit);
diff -ruN a/libass/ass_nv.h b/libass/ass_nv.h
--- a/libass/ass_nv.h
+++ b/libass/ass_nv.h
@@ -26,7 +26,7 @@
     ASS_NV_CACHE_COUNT
 };
 
-extern int ass_nv_active;  // latched at the start of ass_render_frame
+extern int ass_nv_active;  // threads timing a frame right now (atomic; 0004)
 
 int  ass_nv_frame_begin(void);            // 1 if this frame is timed
 void ass_nv_frame_end(unsigned n_images);
@@ -35,9 +35,14 @@
 void ass_nv_stage_leave_slow(int prev);
 void ass_nv_cache_count_slow(int which, int hit);
 
+static inline int ass_nv_timing(void)
+{
+    return __atomic_load_n(&ass_nv_active, __ATOMIC_RELAXED);
+}
+
 static inline int ass_nv_stage_enter(int stage)
 {
-    return ass_nv_active ? ass_nv_stage_enter_slow(stage) : -1;
+    return ass_nv_timing() ? ass_nv_stage_enter_slow(stage) : -1;
 }
 
 static inline void ass_nv_stage_leave(int prev)
@@ -48,7 +53,7 @@
 
 static inline void ass_nv_cache_count(int which, int hit)
 {
-    if (ass_nv_active)
+    if (ass_nv_timing())
         ass_nv_cache_count_slow(which, hit);
 }
 
diff -ruN a/libass/ass_render_api.c b/libass/ass_render_api.c
--- a/libass/ass_render_api.c
+++ b/libass/ass_render_api.c
@@ -26,6 +26,9 @@
 #include "ass_render.h"
 #include "ass_utils.h"
 #include "ass_nv.h"
+#include "ass_priv.h"
+#include <pthread.h>
+#include <stdlib.h>
 
 #include <string.h>
 #include <time.h>
@@ -221,11 +224,48 @@
 
 /* ---- Nuvio TPK additions (tools/tpk/libass-nv) ---- */
 
+/* Timers are per THREAD (0004): several renderers may run ass_render_frame
+ * at the same time on different threads (the app's parallel renderers). The
+ * state lives in a pthread key, not in compiler TLS: the Tizen 4/5 .so is
+ * loaded by an ELF loader that refuses PT_TLS. ass_nv_active counts the
+ * threads timing a frame right now, so the inline fast path stays one load
+ * when nobody is timing. */
 int ass_nv_active;
 static int nv_enabled;
-static int nv_cur;
-static long long nv_t0, nv_frame_t0;
-static ASS_NvPerf nv_acc;
+
+typedef struct {
+    int on;
+    int cur;
+    long long t0, frame_t0;
+    ASS_NvPerf acc;
+} NvThread;
+
+static pthread_key_t nv_key;
+static pthread_once_t nv_once = PTHREAD_ONCE_INIT;
+
+static void nv_key_free(void *p)
+{
+    free(p);
+}
+
+static void nv_key_make(void)
+{
+    pthread_key_create(&nv_key, nv_key_free);
+}
+
+static NvThread *nv_thread(int create)
+{
+    pthread_once(&nv_once, nv_key_make);
+    NvThread *st = pthread_getspecific(nv_key);
+    if (!st && create) {
+        st = calloc(1, sizeof(*st));
+        if (st && pthread_setspecific(nv_key, st)) {
+            free(st);
+            st = NULL;
+        }
+    }
+    return st;
+}
 
 static inline long long nv_now(void)
 {
@@ -236,65 +276,168 @@
 
 void ass_nv_perf_enable(int on)
 {
-    nv_enabled = !!on;
+    __atomic_store_n(&nv_enabled, !!on, __ATOMIC_RELAXED);
 }
 
 int ass_nv_frame_begin(void)
 {
-    ass_nv_active = nv_enabled;
-    if (!ass_nv_active)
+    if (!__atomic_load_n(&nv_enabled, __ATOMIC_RELAXED))
+        return 0;
+    NvThread *st = nv_thread(1);
+    if (!st)
         return 0;
-    nv_cur = ASS_NV_ST_OTHER;
-    nv_frame_t0 = nv_t0 = nv_now();
+    st->on = 1;
+    st->cur = ASS_NV_ST_OTHER;
+    st->frame_t0 = st->t0 = nv_now();
+    __atomic_add_fetch(&ass_nv_active, 1, __ATOMIC_RELAXED);
     return 1;
 }
 
 void ass_nv_frame_end(unsigned n_images)
 {
+    NvThread *st = nv_thread(0);
+    if (!st || !st->on)
+        return;
     long long t = nv_now();
-    nv_acc.ns_stage[nv_cur] += t - nv_t0;
-    nv_acc.ns_frame += t - nv_frame_t0;
-    nv_acc.frames++;
-    nv_acc.images += n_images;
-    ass_nv_active = 0;
+    st->acc.ns_stage[st->cur] += t - st->t0;
+    st->acc.ns_frame += t - st->frame_t0;
+    st->acc.frames++;
+    st->acc.images += n_images;
+    st->on = 0;
+    __atomic_sub_fetch(&ass_nv_active, 1, __ATOMIC_RELAXED);
 }
 
 void ass_nv_event_count(void)
 {
-    if (ass_nv_active)
-        nv_acc.events++;
+    if (!ass_nv_timing())
+        return;
+    NvThread *st = nv_thread(0);
+    if (st && st->on)
+        st->acc.events++;
 }
 
 int ass_nv_stage_enter_slow(int stage)
 {
+    NvThread *st = nv_thread(0);
+    if (!st || !st->on)
+        return -1;
     long long t = nv_now();
-    nv_acc.ns_stage[nv_cur] += t - nv_t0;
-    nv_t0 = t;
-    int prev = nv_cur;
-    nv_cur = stage;
+    st->acc.ns_stage[st->cur] += t - st->t0;
+    st->t0 = t;
+    int prev = st->cur;
+    st->cur = stage;
     return prev;
 }
 
 void ass_nv_stage_leave_slow(int prev)
 {
+    NvThread *st = nv_thread(0);
+    if (!st || !st->on)
+        return;
     long long t = nv_now();
-    nv_acc.ns_stage[nv_cur] += t - nv_t0;
-    nv_t0 = t;
-    nv_cur = prev;
+    st->acc.ns_stage[st->cur] += t - st->t0;
+    st->t0 = t;
+    st->cur = prev;
 }
 
 void ass_nv_cache_count_slow(int which, int hit)
 {
+    NvThread *st = nv_thread(0);
+    if (!st || !st->on)
+        return;
     if (hit)
-        nv_acc.cache_hit[which]++;
+        st->acc.cache_hit[which]++;
     else
-        nv_acc.cache_miss[which]++;
+        st->acc.cache_miss[which]++;
 }
 
 void ass_nv_perf_take(ASS_NvPerf *out)
 {
-    *out = nv_acc;
-    memset(&nv_acc, 0, sizeof(nv_acc));
+    NvThread *st = nv_thread(0);
+    if (!st) {
+        memset(out, 0, sizeof(*out));
+        return;
+    }
+    *out = st->acc;
+    memset(&st->acc, 0, sizeof(st->acc));
+}
+
+/* Deep copy of a track for another renderer (0004). Events get no
+ * render_priv (collision state is per renderer), the parser state is fresh,
+ * and the feature/header flags are copied so layout is the same. */
+static char *nv_dup(const char *s)
+{
+    return s ? strdup(s) : NULL;
+}
+
+ASS_Track *ass_nv_track_clone(ASS_Track *src)
+{
+    if (!src)
+        return NULL;
+    ASS_Track *t = ass_new_track(src->library);
+    if (!t)
+        return NULL;
+    /* ass_new_track already holds a "Default" style at index 0: drop it, or
+     * every copied style index would be off by one. */
+    for (int i = 0; i < t->n_styles; i++)
+        ass_free_style(t, i);
+    t->n_styles = 0;
+    t->track_type = src->track_type;
+    t->PlayResX = src->PlayResX;
+    t->PlayResY = src->PlayResY;
+    t->Timer = src->Timer;
+    t->WrapStyle = src->WrapStyle;
+    t->ScaledBorderAndShadow = src->ScaledBorderAndShadow;
+    t->Kerning = src->Kerning;
+    t->YCbCrMatrix = src->YCbCrMatrix;
+    t->default_style = src->default_style;
+    t->LayoutResX = src->LayoutResX;
+    t->LayoutResY = src->LayoutResY;
+    t->Language = nv_dup(src->Language);
+    t->name = nv_dup(src->name);
+    t->style_format = nv_dup(src->style_format);
+    t->event_format = nv_dup(src->event_format);
+    if (t->parser_priv && src->parser_priv) {
+        t->parser_priv->header_flags = src->parser_priv->header_flags;
+        t->parser_priv->feature_flags = src->parser_priv->feature_flags;
+        t->parser_priv->prune_delay = src->parser_priv->prune_delay;
+    }
+    for (int i = 0; i < src->n_styles; i++) {
+        int k = ass_alloc_style(t);
+        if (k < 0)
+            goto fail;
+        ASS_Style *d = &t->styles[k];
+        *d = src->styles[i];
+        d->Name = nv_dup(src->styles[i].Name);
+        d->FontName = nv_dup(src->styles[i].FontName);
+        if ((src->styles[i].Name && !d->Name) || (src->styles[i].FontName && !d->FontName))
+            goto fail;
+    }
+    for (int i = 0; i < src->n_events; i++) {
+        int k = ass_alloc_event(t);
+        if (k < 0)
+            goto fail;
+        ASS_Event *d = &t->events[k];
+        const ASS_Event *e = &src->events[i];
+        d->Start = e->Start;
+        d->Duration = e->Duration;
+        d->ReadOrder = e->ReadOrder;
+        d->Layer = e->Layer;
+        d->Style = e->Style;
+        d->MarginL = e->MarginL;
+        d->MarginR = e->MarginR;
+        d->MarginV = e->MarginV;
+        d->Name = nv_dup(e->Name);
+        d->Effect = nv_dup(e->Effect);
+        d->Text = nv_dup(e->Text);
+        d->render_priv = NULL;
+        if ((e->Name && !d->Name) || (e->Effect && !d->Effect) || (e->Text && !d->Text))
+            goto fail;
+    }
+    return t;
+fail:
+    ass_free_track(t);
+    return NULL;
 }
 
 void ass_nv_flush_caches(ASS_Renderer *priv)
@@ -333,7 +476,21 @@
 int ass_nv32_get_threads(void);
 int ass_nv_set_threads(int n) { return ass_nv32_set_threads(n); }
 int ass_nv_get_threads(void) { return ass_nv32_get_threads(); }
+void ass_nv32_set_par_min(size_t lanes);
+size_t ass_nv32_get_par_min(void);
+void ass_nv32_par_stats_take(unsigned *jobs, unsigned *split, unsigned *small, unsigned *busy,
+                             unsigned *one, unsigned long long *lanes, unsigned long long *lanes_split);
+void ass_nv_set_par_min(size_t lanes) { ass_nv32_set_par_min(lanes ? lanes : 1); }
+size_t ass_nv_get_par_min(void) { return ass_nv32_get_par_min(); }
+void ass_nv_par_stats_take(ASS_NvParStats *out)
+{
+    ass_nv32_par_stats_take(&out->jobs, &out->split, &out->small, &out->busy, &out->single,
+                            &out->lanes, &out->lanes_split);
+}
 #else
 int ass_nv_set_threads(int n) { (void) n; return 1; }
 int ass_nv_get_threads(void) { return 1; }
+void ass_nv_set_par_min(size_t lanes) { (void) lanes; }
+size_t ass_nv_get_par_min(void) { return 0; }
+void ass_nv_par_stats_take(ASS_NvParStats *out) { memset(out, 0, sizeof(*out)); }
 #endif
