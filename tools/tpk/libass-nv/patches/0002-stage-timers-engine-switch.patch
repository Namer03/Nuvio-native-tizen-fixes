+static ASS_Image *nv_render_frame(ASS_Renderer *priv, ASS_Track *track,
+                                   long long now, int *detect_change);
+
 ASS_Image *ass_render_frame(ASS_Renderer *priv, ASS_Track *track,
                             long long now, int *detect_change)
+{
+    if (!ass_nv_frame_begin())
+        return nv_render_frame(priv, track, now, detect_change);
+    ASS_Image *img = nv_render_frame(priv, track, now, detect_change);
+    unsigned n_img = 0;
+    for (ASS_Image *i = img; i; i = i->next)
+        n_img++;
+    ass_nv_frame_end(n_img);
+    return img;
+}
+
+static ASS_Image *nv_render_frame(ASS_Renderer *priv, ASS_Track *track,
+                                  long long now, int *detect_change)
 {
     // init frame
     if (!ass_start_frame(priv, track, now)) {
@@ -3391,6 +3445,7 @@ ASS_Image *ass_render_frame(ASS_Renderer *priv, ASS_Track *track,
             }
             if (ass_render_event(&priv->state, event, priv->eimg + cnt))
                 cnt++;
+            ass_nv_event_count();
