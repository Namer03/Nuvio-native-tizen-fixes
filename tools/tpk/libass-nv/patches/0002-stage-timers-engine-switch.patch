     }
 
diff --git a/libass/ass_render_api.c b/libass/ass_render_api.c
index ee1620a..db1a878 100644
--- a/libass/ass_render_api.c
+++ b/libass/ass_render_api.c
@@ -25,6 +25,10 @@
 
 #include "ass_render.h"
 #include "ass_utils.h"
+#include "ass_nv.h"
+
+#include <string.h>
+#include <time.h>
 
 static void ass_reconfigure(ASS_Renderer *priv)
 {
@@ -213,3 +217,113 @@ ass_create_font_provider(ASS_Renderer *priv, ASS_FontProviderFuncs *funcs,
 {
     return ass_font_provider_new(priv->fontselect, funcs, data);
 }
+
+
+/* ---- Nuvio TPK additions (tools/tpk/libass-nv) ---- */
+
+int ass_nv_active;
+static int nv_enabled;
+static int nv_cur;
+static long long nv_t0, nv_frame_t0;
+static ASS_NvPerf nv_acc;
+
+static inline long long nv_now(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * 1000000000LL + ts.tv_nsec;
+}
+
+void ass_nv_perf_enable(int on)
+{
+    nv_enabled = !!on;
+}
+
+int ass_nv_frame_begin(void)
+{
+    ass_nv_active = nv_enabled;
+    if (!ass_nv_active)
+        return 0;
+    nv_cur = ASS_NV_ST_OTHER;
+    nv_frame_t0 = nv_t0 = nv_now();
+    return 1;
+}
+
+void ass_nv_frame_end(unsigned n_images)
+{
+    long long t = nv_now();
+    nv_acc.ns_stage[nv_cur] += t - nv_t0;
+    nv_acc.ns_frame += t - nv_frame_t0;
+    nv_acc.frames++;
+    nv_acc.images += n_images;
+    ass_nv_active = 0;
+}
+
+void ass_nv_event_count(void)
+{
+    if (ass_nv_active)
+        nv_acc.events++;
+}
+
+int ass_nv_stage_enter_slow(int stage)
+{
+    long long t = nv_now();
+    nv_acc.ns_stage[nv_cur] += t - nv_t0;
+    nv_t0 = t;
+    int prev = nv_cur;
+    nv_cur = stage;
+    return prev;
+}
+
+void ass_nv_stage_leave_slow(int prev)
+{
+    long long t = nv_now();
+    nv_acc.ns_stage[nv_cur] += t - nv_t0;
+    nv_t0 = t;
+    nv_cur = prev;
+}
+
+void ass_nv_cache_count_slow(int which, int hit)
+{
+    if (hit)
+        nv_acc.cache_hit[which]++;
+    else
+        nv_acc.cache_miss[which]++;
+}
+
+void ass_nv_perf_take(ASS_NvPerf *out)
+{
+    *out = nv_acc;
+    memset(&nv_acc, 0, sizeof(nv_acc));
+}
+
+void ass_nv_flush_caches(ASS_Renderer *priv)
+{
+    ass_reconfigure(priv);
+}
+
+int ass_nv_simd_available(void)
+{
+    return ass_get_cpu_flags(ASS_CPU_FLAG_ALL) != ASS_CPU_FLAG_NONE;
+}
+
+BitmapBlendFunc ass_add_bitmaps_c;
+
+int ass_nv_get_engine(ASS_Renderer *priv)
+{
+    return priv->engine.add_bitmaps != ass_add_bitmaps_c;
+}
+
+int ass_nv_set_engine(ASS_Renderer *priv, int simd)
+{
+    unsigned flags = simd ? ASS_CPU_FLAG_ALL : ASS_CPU_FLAG_NONE;
+#if CONFIG_LARGE_TILES
+    flags |= ASS_FLAG_LARGE_TILES;
+#endif
+    BitmapEngine engine = ass_bitmap_engine_init(flags);
+    if (engine.add_bitmaps != priv->engine.add_bitmaps) {
+        priv->engine = engine;
+        ass_reconfigure(priv);
+    }
+    return ass_nv_get_engine(priv);
+}
