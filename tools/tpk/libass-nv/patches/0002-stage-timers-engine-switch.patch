diff --git a/libass/ass.h b/libass/ass.h
index 851ca7c..20816e2 100644
--- a/libass/ass.h
+++ b/libass/ass.h
@@ -848,6 +848,43 @@ void *ass_malloc(size_t size);
  */
 void ass_free(void *ptr);
 
+/*
+ * Nuvio TPK additions (tools/tpk/libass-nv). Not upstream API.
+ */
+#define ASS_NV_API 1
+
+typedef struct ass_nv_perf {
+    long long ns_frame;     // wall time inside ass_render_frame
+    long long ns_stage[8];  // other, shape, outline, raster, blur, be, compose, clip
+    unsigned frames, events, images;
+    unsigned cache_hit[3], cache_miss[3];  // outline, bitmap, composite
+} ASS_NvPerf;
+
+/**
+ * \brief Turn the per-stage timers on or off (process wide, default off).
+ * Takes effect at the next ass_render_frame.
+ */
+void ass_nv_perf_enable(int on);
+
+/**
+ * \brief Copy the counters accumulated since the last call and reset them.
+ * Call it from the thread that calls ass_render_frame.
+ */
+void ass_nv_perf_take(ASS_NvPerf *out);
+
+/**
+ * \brief Select the bitmap engine: 1 = SIMD (NEON on armv7), 0 = plain C.
+ * Empties the renderer caches. Returns the engine now in use.
+ */
+int ass_nv_set_engine(ASS_Renderer *priv, int simd);
+int ass_nv_get_engine(ASS_Renderer *priv);
+int ass_nv_simd_available(void);
+
+/**
+ * \brief Empty the outline, bitmap and composite caches (cold-cache bench).
+ */
+void ass_nv_flush_caches(ASS_Renderer *priv);
+
 #undef ASS_DEPRECATED
 #undef ASS_DEPRECATED_ENUM
 
