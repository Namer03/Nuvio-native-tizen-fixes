diff --git a/libass/ass_nv.h b/libass/ass_nv.h
new file mode 100644
index 0000000..4cb6a15
--- /dev/null
+++ b/libass/ass_nv.h
@@ -0,0 +1,55 @@
+/*
+ * Nuvio TPK additions to libass 0.17.5 (tools/tpk/libass-nv):
+ * per-stage timers and cache counters for ass_render_frame.
+ * Internal header; the public part is at the end of ass.h (ASS_NV_API).
+ */
+
+#ifndef LIBASS_NV_H
+#define LIBASS_NV_H
+
+enum {
+    ASS_NV_ST_OTHER = 0,   // layout, parsing, image list, everything else
+    ASS_NV_ST_SHAPE,       // HarfBuzz/FriBidi shaping
+    ASS_NV_ST_OUTLINE,     // glyph/drawing outline construction (FreeType)
+    ASS_NV_ST_RASTER,      // transform + rasterizer (fill_* / merge)
+    ASS_NV_ST_GAUSS,       // \blur: stripe pipeline
+    ASS_NV_ST_BE,          // \be: box blur passes
+    ASS_NV_ST_COMPOSE,     // composite: add_bitmaps, fix_outline, shadow shift
+    ASS_NV_ST_CLIP,        // vector \clip / \iclip: mul / imul_bitmaps
+    ASS_NV_ST_COUNT
+};
+
+enum {
+    ASS_NV_CACHE_OUTLINE = 0,
+    ASS_NV_CACHE_BITMAP,
+    ASS_NV_CACHE_COMPOSITE,
+    ASS_NV_CACHE_COUNT
+};
+
+extern int ass_nv_active;  // latched at the start of ass_render_frame
+
+int  ass_nv_frame_begin(void);            // 1 if this frame is timed
+void ass_nv_frame_end(unsigned n_images);
+void ass_nv_event_count(void);
+int  ass_nv_stage_enter_slow(int stage);
+void ass_nv_stage_leave_slow(int prev);
+void ass_nv_cache_count_slow(int which, int hit);
+
+static inline int ass_nv_stage_enter(int stage)
+{
+    return ass_nv_active ? ass_nv_stage_enter_slow(stage) : -1;
+}
+
+static inline void ass_nv_stage_leave(int prev)
+{
+    if (prev >= 0)
+        ass_nv_stage_leave_slow(prev);
+}
+
+static inline void ass_nv_cache_count(int which, int hit)
+{
+    if (ass_nv_active)
+        ass_nv_cache_count_slow(which, hit);
+}
+
+#endif /* LIBASS_NV_H */
