From: nv <noreply@anthropic.com>
Date: Sat, 24 Oct 2026 12:00:00 +0200
Subject: [PATCH 5/5] libass: deferred blur (sharp composites + recipe for a GPU
 blur; ass_nv_defer_apply rebuilds the exact CPU picture)

diff --git a/libass/ass.h b/libass/ass.h
index 3fb7e54..4589c51 100644
--- a/libass/ass.h
+++ b/libass/ass.h
@@ -929,6 +929,77 @@ void ass_nv_par_stats_take(ASS_NvParStats *out);
  */
 ASS_Track *ass_nv_track_clone(ASS_Track *src);
 
+#define ASS_NV_API_DEFER 1
+
+/*
+ * 0005 (deferred blur). With it on, libass skips the gaussian blur of a
+ * composite (and the outline fix and the shadow subpixel shift that come
+ * after it) and hands the app the sharp bitmap plus the recipe, so the blur
+ * can run on the GPU. A composite is deferred only when it has a gaussian
+ * blur, no \be and no vector clip; everything else takes the normal path.
+ * The image's own bitmap is then the SHARP picture (do not draw it).
+ */
+
+/**
+ * \brief Turn deferred blur on or off for this renderer (default off).
+ * Deferred and normal composites have different cache keys, so switching
+ * needs no flush. Returns the new state.
+ */
+int ass_nv_set_deferred_blur(ASS_Renderer *priv, int on);
+int ass_nv_get_deferred_blur(ASS_Renderer *priv);
+
+typedef struct ass_nv_defer {
+    /* The whole sharp bitmap this image is a part of, already padded to the
+     * size libass's blur gives it (blurring it keeps its size). */
+    const unsigned char *src;
+    int src_w, src_h, src_stride;
+    int sub_x, sub_y;           // this image's top-left inside src (w x h of the image)
+    int core_x, core_y, core_w, core_h;  // src without the padding (libass's CPU blur input)
+    double r2x, r2y;            // gaussian variance in pixels^2 (sigma^2) along x and y
+    /* After the blur, when fix: v = v > g ? v - g / 2 : 0 (integers), with g
+     * the fill bitmap at (x + fill_dx, y + fill_dy) of src (0 outside it). */
+    int fix;
+    const unsigned char *fill;
+    int fill_w, fill_h, fill_stride, fill_dx, fill_dy;
+    /* Then (shadows) libass's subpixel shift, in 1/64 pixel (0..63):
+     * v[x] ~ v[x] * (64 - s) / 64 + v[x - 1] * s / 64, x first, then y. */
+    int shift_x, shift_y;
+} ASS_NvDefer;
+
+/**
+ * \brief The recipe of a deferred image. Returns 0 for a normal image (draw
+ * its bitmap as usual). Valid while the image is (ass_render_frame keeps it
+ * until the next frame of that renderer).
+ */
+int ass_nv_image_defer(const ASS_Image *img, ASS_NvDefer *out);
+
+/**
+ * \brief Apply the recipe on the CPU with libass's own blur, outline fix and
+ * shift: writes the w x h picture the normal path would have given (byte
+ * identical). For checks and as a fallback. Returns 0 on failure.
+ */
+int ass_nv_defer_apply_cpu(ASS_Renderer *priv, const ASS_Image *img,
+                           unsigned char *dst, int dst_stride);
+
+/**
+ * \brief The same from a recipe alone (the app's own copies of src and fill,
+ * any thread): writes the w x h picture at sub_x, sub_y. Returns 0 on failure.
+ */
+int ass_nv_defer_apply(const ASS_NvDefer *d, int w, int h, unsigned char *dst, int dst_stride);
+
+typedef struct ass_nv_defer_stats {
+    unsigned blurred;    // combined bitmaps with a gaussian blur, per frame
+    unsigned deferred;   // of those: deferred
+    unsigned kept_be;    // kept on the CPU: \be with the blur
+    unsigned kept_clip;  // kept on the CPU: vector clip
+} ASS_NvDeferStats;
+
+/**
+ * \brief Copy this renderer's deferred-blur counters and reset them. Call it
+ * from the thread that renders with it.
+ */
+void ass_nv_defer_stats_take(ASS_Renderer *priv, ASS_NvDeferStats *out);
+
 #undef ASS_DEPRECATED
 #undef ASS_DEPRECATED_ENUM
 
diff --git a/libass/ass_bitmap.h b/libass/ass_bitmap.h
index c337bf1..b7cf2df 100644
--- a/libass/ass_bitmap.h
+++ b/libass/ass_bitmap.h
@@ -48,6 +48,9 @@ void ass_synth_blur(const BitmapEngine *engine, Bitmap *bm,
                     int be, double blur_r2x, double blur_r2y);
 
 bool ass_gaussian_blur(const BitmapEngine *engine, Bitmap *bm, double r2x, double r2y);
+/* 0005: give `bm` the size and position ass_gaussian_blur would, without
+ * blurring (the picture lands at core[0], core[1]; core[2..3] = old w, h). */
+bool ass_nv_blur_pad(const BitmapEngine *engine, Bitmap *bm, double r2x, double r2y, int32_t core[4]);
 void ass_shift_bitmap(Bitmap *bm, int shift_x, int shift_y);
 void ass_fix_outline(Bitmap *bm_g, Bitmap *bm_o);
 
diff --git a/libass/ass_blur.c b/libass/ass_blur.c
index ec91a92..a23abf6 100644
--- a/libass/ass_blur.c
+++ b/libass/ass_blur.c
@@ -165,6 +165,37 @@ static void find_best_method(BlurMethod *blur, double r2)
         blur->coeff[i] = (int) (0x10000 * mu[i] + 0.5);
 }
 
+bool ass_nv_blur_pad(const BitmapEngine *engine, Bitmap *bm, double r2x, double r2y, int32_t core[4])
+{
+    BlurMethod blur_x, blur_y;
+    find_best_method(&blur_x, r2x);
+    if (r2y == r2x)
+        memcpy(&blur_y, &blur_x, sizeof(blur_y));
+    else find_best_method(&blur_y, r2y);
+
+    uint32_t w = bm->w, h = bm->h;
+    int offset_x = ((2 * blur_x.radius + 9) << blur_x.level) - 5;
+    int offset_y = ((2 * blur_y.radius + 9) << blur_y.level) - 5;
+    uint32_t end_w = ((w + offset_x) & ~((1 << blur_x.level) - 1)) - 4;
+    uint32_t end_h = ((h + offset_y) & ~((1 << blur_y.level) - 1)) - 4;
+    int32_t dl = ((blur_x.radius + 4) << blur_x.level) - 4;
+    int32_t dt = ((blur_y.radius + 4) << blur_y.level) - 4;
+    if ((uint64_t) end_w * end_h > INT_MAX / 4)
+        return false;
+
+    Bitmap nb;
+    if (!ass_alloc_bitmap(engine, &nb, end_w, end_h, true))
+        return false;
+    for (uint32_t y = 0; y < h; y++)
+        memcpy(nb.buffer + (y + dt) * nb.stride + dl, bm->buffer + y * bm->stride, w);
+    nb.left = bm->left - dl;
+    nb.top  = bm->top  - dt;
+    ass_free_bitmap(bm);
+    *bm = nb;
+    core[0] = dl; core[1] = dt; core[2] = w; core[3] = h;
+    return true;
+}
+
