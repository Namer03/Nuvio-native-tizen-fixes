                     int32_t y = double_to_d6(info->shadow_y * state->border_scale_y);
@@ -2667,6 +2684,175 @@ int ass_be_padding(int be)
 
 static size_t nv_ass_composite_construct(void *key, void *value, void *priv);
 
+/* 0005 deferred blur: the composite stays sharp (padded to the blurred size)
+ * and records what the normal path below would do after the blur. Returns 0
+ * when the composite must take the normal path (nothing changed yet). */
+static int nv_defer_construct(ASS_Renderer *render_priv, CompositeHashKey *k,
+                              CompositeHashValue *v, double r2x, double r2y)
+{
+    const BitmapEngine *engine = &render_priv->engine;
+    int flags = k->filter.flags;
+    int blur_fill = !(flags & FILTER_NONZERO_BORDER) || (flags & FILTER_BORDER_STYLE_3);
+    int fix_o = !(flags & FILTER_FILL_IN_BORDER);
+    /* An outline fix against a BLURRED fill never happens in libass (a
+     * bordered fill stays sharp); if it ever did, keep the exact CPU path. */
+    if (blur_fill && fix_o && v->bm.buffer && v->bm_o.buffer)
+        return 0;
+    if (blur_fill && v->bm.buffer && !ass_nv_blur_pad(engine, &v->bm, r2x, r2y, v->nv_core[0]))
+        return 0;
+    if (v->bm_o.buffer && !ass_nv_blur_pad(engine, &v->bm_o, r2x, r2y, v->nv_core[1])) {
+        if (blur_fill && v->bm.buffer) {
+            /* undo the padding of bm: back to the picture alone */
+            Bitmap c;
+            int32_t *core = v->nv_core[0];
+            if (!ass_alloc_bitmap(engine, &c, core[2], core[3], false))
+                return 0;   // out of memory either way
+            for (int32_t y = 0; y < core[3]; y++)
+                memcpy(c.buffer + y * c.stride, v->bm.buffer + (y + core[1]) * v->bm.stride + core[0], core[2]);
+            c.left = v->bm.left + core[0];
+            c.top  = v->bm.top  + core[1];
+            ass_free_bitmap(&v->bm);
+            v->bm = c;
+        }
+        return 0;
+    }
+    v->nv_defer = 1;
+    v->nv_blur_fill = blur_fill && v->bm.buffer;
+    v->nv_r2x = r2x;
+    v->nv_r2y = r2y;
+    v->nv_fix_o = fix_o;
+    if (flags & FILTER_NONZERO_SHADOW) {
+        if (flags & FILTER_NONZERO_BORDER) {
+            ass_copy_bitmap(engine, &v->bm_s, &v->bm_o);
+            memcpy(v->nv_core[2], v->nv_core[1], sizeof(v->nv_core[2]));
+            v->nv_fix_s = !(flags & FILTER_FILL_IN_SHADOW);
+        } else if (flags & FILTER_BORDER_STYLE_3) {
+            v->bm_s = v->bm_o;
+            memset(&v->bm_o, 0, sizeof(v->bm_o));
+            memcpy(v->nv_core[2], v->nv_core[1], sizeof(v->nv_core[2]));
+        } else {
+            ass_copy_bitmap(engine, &v->bm_s, &v->bm);
+            memcpy(v->nv_core[2], v->nv_core[0], sizeof(v->nv_core[2]));
+        }
+        v->nv_s_left0 = v->bm_s.left;
+        v->nv_s_top0  = v->bm_s.top;
+        v->bm_s.left += k->filter.shadow.x >> 6;
+        v->bm_s.top  += k->filter.shadow.y >> 6;
+        v->nv_shift_x = k->filter.shadow.x & SUBPIXEL_MASK;
+        v->nv_shift_y = k->filter.shadow.y & SUBPIXEL_MASK;
+    }
+    return 1;
+}
+
+int ass_nv_image_defer(const ASS_Image *img, ASS_NvDefer *out)
+{
+    const ASS_ImagePriv *p = (const ASS_ImagePriv *) img;
+    const CompositeHashValue *v = p ? p->source : NULL;
+    const Bitmap *b;
+    int which;
+    if (!v || !v->nv_defer)
+        return 0;
+    switch (img->type) {
+    case IMAGE_TYPE_CHARACTER: if (!v->nv_blur_fill) return 0; b = &v->bm;   which = 0; break;
+    case IMAGE_TYPE_OUTLINE:   b = &v->bm_o; which = 1; break;
+    case IMAGE_TYPE_SHADOW:    b = &v->bm_s; which = 2; break;
+    default: return 0;
+    }
+    if (!b->buffer || img->bitmap < b->buffer ||
+        img->bitmap >= b->buffer + b->stride * b->h)
+        return 0;
+    ptrdiff_t off = img->bitmap - b->buffer;
+    memset(out, 0, sizeof(*out));
+    out->src = b->buffer;
+    out->src_w = b->w;
+    out->src_h = b->h;
+    out->src_stride = (int) b->stride;
+    out->sub_x = (int) (off % b->stride);
+    out->sub_y = (int) (off / b->stride);
+    out->core_x = v->nv_core[which][0];
+    out->core_y = v->nv_core[which][1];
+    out->core_w = v->nv_core[which][2];
+    out->core_h = v->nv_core[which][3];
+    out->r2x = v->nv_r2x;
+    out->r2y = v->nv_r2y;
+    int fix = which == 1 ? v->nv_fix_o : which == 2 ? v->nv_fix_s : 0;
+    if (fix && v->bm.buffer) {
+        int32_t l0 = which == 2 ? v->nv_s_left0 : b->left;
+        int32_t t0 = which == 2 ? v->nv_s_top0  : b->top;
+        out->fix = 1;
+        out->fill = v->bm.buffer;
+        out->fill_w = v->bm.w;
+        out->fill_h = v->bm.h;
+        out->fill_stride = (int) v->bm.stride;
+        out->fill_dx = l0 - v->bm.left;
+        out->fill_dy = t0 - v->bm.top;
+    }
+    if (which == 2) {
+        out->shift_x = v->nv_shift_x;
+        out->shift_y = v->nv_shift_y;
+    }
+    return 1;
+}
+
+#include <pthread.h>
+static pthread_once_t nv_defer_engine_once = PTHREAD_ONCE_INIT;
+static BitmapEngine nv_defer_engine;
+
+static void nv_defer_engine_init(void)
+{
+    unsigned flags = ASS_CPU_FLAG_ALL;
+#if CONFIG_LARGE_TILES
+    flags |= ASS_FLAG_LARGE_TILES;
+#endif
+    nv_defer_engine = ass_bitmap_engine_init(flags);
+}
+
+int ass_nv_defer_apply(const ASS_NvDefer *d, int w, int h, unsigned char *dst, int dst_stride)
+{
+    Bitmap t;
+    pthread_once(&nv_defer_engine_once, nv_defer_engine_init);
+    if (w <= 0 || h <= 0 || d->sub_x < 0 || d->sub_y < 0 ||
+        d->sub_x + w > d->src_w || d->sub_y + h > d->src_h)
+        return 0;
+    if (!ass_alloc_bitmap(&nv_defer_engine, &t, d->core_w, d->core_h, true))
+        return 0;
+    for (int y = 0; y < d->core_h; y++)
+        memcpy(t.buffer + y * t.stride, d->src + (ptrdiff_t) (y + d->core_y) * d->src_stride + d->core_x, d->core_w);
+    t.left = d->core_x;
+    t.top  = d->core_y;
+    if (!ass_gaussian_blur(&nv_defer_engine, &t, d->r2x, d->r2y) ||
+        t.left != 0 || t.top != 0 || t.w != d->src_w || t.h != d->src_h) {
+        ass_free_bitmap(&t);
+        return 0;
+    }
+    if (d->fix) {
+        Bitmap g;
+        g.left = -d->fill_dx;
+        g.top  = -d->fill_dy;
+        g.w = d->fill_w;
+        g.h = d->fill_h;
+        g.stride = d->fill_stride;
+        g.buffer = (uint8_t *) d->fill;
+        ass_fix_outline(&g, &t);
+    }
+    if (d->shift_x || d->shift_y)
+        ass_shift_bitmap(&t, d->shift_x, d->shift_y);
+    for (int y = 0; y < h; y++)
+        memcpy(dst + (ptrdiff_t) y * dst_stride, t.buffer + (ptrdiff_t) (y + d->sub_y) * t.stride + d->sub_x, w);
+    ass_free_bitmap(&t);
+    return 1;
+}
+
+int ass_nv_defer_apply_cpu(ASS_Renderer *priv, const ASS_Image *img,
+                           unsigned char *dst, int dst_stride)
+{
+    ASS_NvDefer d;
+    (void) priv;
+    if (!ass_nv_image_defer(img, &d))
+        return 0;
+    return ass_nv_defer_apply(&d, img->w, img->h, dst, dst_stride);
+}
+
 size_t ass_composite_construct(void *key, void *value, void *priv)
 {
     int nv_prev = ass_nv_stage_enter(ASS_NV_ST_COMPOSE);
@@ -2757,6 +2943,10 @@ static size_t nv_ass_composite_construct(void *key, void *value, void *priv)
     int flags = k->filter.flags;
     double r2x = restore_blur(k->filter.blur_x);
     double r2y = restore_blur(k->filter.blur_y);
+    if ((flags & FILTER_NV_DEFER) && nv_defer_construct(render_priv, k, v, r2x, r2y))
+        return sizeof(CompositeHashKey) + sizeof(CompositeHashValue) +
+            k->bitmap_count * sizeof(BitmapRef) +
+            bitmap_size(&v->bm) + bitmap_size(&v->bm_o) + bitmap_size(&v->bm_s);
     if (!(flags & FILTER_NONZERO_BORDER) || (flags & FILTER_BORDER_STYLE_3))
         ass_synth_blur(&render_priv->engine, &v->bm, k->filter.be, r2x, r2y);
     ass_synth_blur(&render_priv->engine, &v->bm_o, k->filter.be, r2x, r2y);
